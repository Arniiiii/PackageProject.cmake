set(PackageProject.cmake_VERSION @PackageProject.cmake_VERSION@)

set(PACKAGE_PROJECT_ROOT_PATH
    "@PACKAGE_PROJECT_ROOT_PATH@"
    CACHE INTERNAL "The path to the PackageProject directory"
)

function(packageProject)
  include(CMakePackageConfigHelpers)
  include(GNUInstallDirs)

  cmake_parse_arguments(
    PACKAGEPROJECT
    ""
    "NAME;VERSION;INCLUDE_DIR;INCLUDE_DESTINATION;BINARY_DIR;COMPATIBILITY;EXPORT_HEADER;VERSION_HEADER;NAMESPACE;DISABLE_VERSION_SUFFIX;ARCH_INDEPENDENT;INCLUDE_HEADER_PATTERN;CPACK;RUNTIME_DESTINATION"
    "DEPENDENCIES"
    ${ARGN}
  )

  # optional feature: TRUE or FALSE or UNDEFINED! These variables will then hold the respective
  # value from the argument list or be undefined if the associated one_value_keyword could not be
  # found.
  if(PACKAGEPROJECT_DISABLE_VERSION_SUFFIX)
    unset(PACKAGEPROJECT_VERSION_SUFFIX)
  else()
    set(PACKAGEPROJECT_VERSION_SUFFIX -${PACKAGEPROJECT_VERSION})
  endif()

  if(NOT DEFINED PACKAGEPROJECT_COMPATIBILITY)
    set(PACKAGEPROJECT_COMPATIBILITY AnyNewerVersion)
  endif()

  # we want to automatically add :: to our namespace, so only append if a namespace was given in the
  # first place we also provide an alias to ensure that local and installed versions have the same
  # name
  if(DEFINED PACKAGEPROJECT_NAMESPACE)
    if(PACKAGEPROJECT_CPACK)
      set(CPACK_PACKAGE_NAMESPACE ${PACKAGEPROJECT_NAMESPACE})
    endif()
    set(PACKAGEPROJECT_NAMESPACE ${PACKAGEPROJECT_NAMESPACE}::)
    add_library(${PACKAGEPROJECT_NAMESPACE}${PACKAGEPROJECT_NAME} ALIAS ${PACKAGEPROJECT_NAME})
  endif()

  if(DEFINED PACKAGEPROJECT_VERSION_HEADER OR DEFINED PACKAGEPROJECT_EXPORT_HEADER)
    set(PACKAGEPROJECT_VERSION_INCLUDE_DIR ${PACKAGEPROJECT_BINARY_DIR}/PackageProjectInclude)

    if(DEFINED PACKAGEPROJECT_EXPORT_HEADER)
      include(GenerateExportHeader)
      generate_export_header(
        ${PACKAGEPROJECT_NAME} EXPORT_FILE_NAME ${PACKAGEPROJECT_VERSION_INCLUDE_DIR}/${PACKAGEPROJECT_EXPORT_HEADER}
      )
    endif()

    if(DEFINED PACKAGEPROJECT_VERSION_HEADER)
      # clear previous matches
      unset(CMAKE_MATCH_1)
      unset(CMAKE_MATCH_3)
      unset(CMAKE_MATCH_5)
      unset(CMAKE_MATCH_7)

      string(REGEX MATCH "^([0-9]+)(\\.([0-9]+))?(\\.([0-9]+))?(\\.([0-9]+))?$" _
                   "${PACKAGEPROJECT_VERSION}"
      )

      set(PACKAGEPROJECT_VERSION_MAJOR ${CMAKE_MATCH_1})
      set(PACKAGEPROJECT_VERSION_MINOR ${CMAKE_MATCH_3})
      set(PACKAGEPROJECT_VERSION_PATCH ${CMAKE_MATCH_5})
      set(PACKAGEPROJECT_VERSION_TWEAK ${CMAKE_MATCH_7})

      if(NOT DEFINED PACKAGEPROJECT_VERSION_MAJOR)
        set(PACKAGEPROJECT_VERSION_MAJOR "0")
      endif()
      if(NOT DEFINED PACKAGEPROJECT_VERSION_MINOR)
        set(PACKAGEPROJECT_VERSION_MINOR "0")
      endif()
      if(NOT DEFINED PACKAGEPROJECT_VERSION_PATCH)
        set(PACKAGEPROJECT_VERSION_PATCH "0")
      endif()
      if(NOT DEFINED PACKAGEPROJECT_VERSION_TWEAK)
        set(PACKAGEPROJECT_VERSION_TWEAK "0")
      endif()

      string(TOUPPER ${PACKAGEPROJECT_NAME} UPPERCASE_PACKAGEPROJECT_NAME)
      # ensure that the generated macro does not include invalid characters
      string(REGEX REPLACE [^a-zA-Z0-9] _ UPPERCASE_PACKAGEPROJECT_NAME ${UPPERCASE_PACKAGEPROJECT_NAME})
      configure_file(
        ${PACKAGE_PROJECT_ROOT_PATH}/version.h.in
        ${PACKAGEPROJECT_VERSION_INCLUDE_DIR}/${PACKAGEPROJECT_VERSION_HEADER} @ONLY
      )
    endif()

    get_target_property(target_type ${PACKAGEPROJECT_NAME} TYPE)
    if(target_type STREQUAL "INTERFACE_LIBRARY")
      set(VISIBILITY INTERFACE)
    else()
      set(VISIBILITY PUBLIC)
    endif()
    target_include_directories(
      ${PACKAGEPROJECT_NAME} ${VISIBILITY} "$<BUILD_INTERFACE:${PACKAGEPROJECT_VERSION_INCLUDE_DIR}>"
    )
    install(
      DIRECTORY ${PACKAGEPROJECT_VERSION_INCLUDE_DIR}/
      DESTINATION ${PACKAGEPROJECT_INCLUDE_DESTINATION}
      COMPONENT "${PACKAGEPROJECT_NAME}_Development"
    )
  endif()

  set(wbpvf_extra_args "")
  if(NOT DEFINED PACKAGEPROJECT_ARCH_INDEPENDENT)
    get_target_property(target_type "${PACKAGEPROJECT_NAME}" TYPE)
    if(target_type STREQUAL "INTERFACE_LIBRARY")
      set(PACKAGEPROJECT_ARCH_INDEPENDENT YES)
    endif()
  endif()

  if(PACKAGEPROJECT_ARCH_INDEPENDENT)
    set(wbpvf_extra_args ARCH_INDEPENDENT)
    # install to architecture independent (share) directory
    set(INSTALL_DIR_FOR_CMAKE_CONFIGS ${CMAKE_INSTALL_DATADIR})
  else()
    # if x32 or multilib->x32 , install to (lib) directory. if x64, install to (lib64) directory
    set(INSTALL_DIR_FOR_CMAKE_CONFIGS ${CMAKE_INSTALL_LIBDIR})
  endif()

  write_basic_package_version_file(
    "${PACKAGEPROJECT_BINARY_DIR}/${PACKAGEPROJECT_NAME}ConfigVersion.cmake"
    VERSION ${PACKAGEPROJECT_VERSION}
    COMPATIBILITY ${PACKAGEPROJECT_COMPATIBILITY} ${wbpvf_extra_args}
  )

  # set default runtime install subdirectory (RUNTIME_DESTINATION)
  if(NOT DEFINED PACKAGEPROJECT_RUNTIME_DESTINATION)
    set(PACKAGEPROJECT_RUNTIME_DESTINATION ${PACKAGEPROJECT_NAME}${PACKAGEPROJECT_VERSION_SUFFIX})
  endif()

  install(
    TARGETS ${PACKAGEPROJECT_NAME}
    EXPORT ${PACKAGEPROJECT_NAME}Targets
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/${PACKAGEPROJECT_RUNTIME_DESTINATION}
            COMPONENT "${PACKAGEPROJECT_NAME}_Runtime"
            NAMELINK_COMPONENT "${PACKAGEPROJECT_NAME}_Development"
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}/${PACKAGEPROJECT_RUNTIME_DESTINATION}
            COMPONENT "${PACKAGEPROJECT_NAME}_Development"
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}/${PACKAGEPROJECT_RUNTIME_DESTINATION}
            COMPONENT "${PACKAGEPROJECT_NAME}_Runtime"
    BUNDLE DESTINATION ${CMAKE_INSTALL_BINDIR}/${PACKAGEPROJECT_RUNTIME_DESTINATION}
           COMPONENT "${PACKAGEPROJECT_NAME}_Runtime"
    PUBLIC_HEADER DESTINATION ${PACKAGEPROJECT_INCLUDE_DESTINATION} COMPONENT "${PACKAGEPROJECT_NAME}_Development"
    INCLUDES
    DESTINATION "${PACKAGEPROJECT_INCLUDE_DESTINATION}"
  )

  set("${PACKAGEPROJECT_NAME}_INSTALL_CMAKEDIR"
      "${INSTALL_DIR_FOR_CMAKE_CONFIGS}/cmake/${PACKAGEPROJECT_NAME}${PACKAGEPROJECT_VERSION_SUFFIX}"
      CACHE PATH "CMake package config location relative to the install prefix"
  )

  mark_as_advanced("${PACKAGEPROJECT_NAME}_INSTALL_CMAKEDIR")

  configure_file(
    ${PACKAGE_PROJECT_ROOT_PATH}/Config.cmake.in
    "${PACKAGEPROJECT_BINARY_DIR}/${PACKAGEPROJECT_NAME}Config.cmake" @ONLY
  )

  install(
    EXPORT ${PACKAGEPROJECT_NAME}Targets
    DESTINATION "${${PACKAGEPROJECT_NAME}_INSTALL_CMAKEDIR}"
    NAMESPACE ${PACKAGEPROJECT_NAMESPACE}
    COMPONENT "${PACKAGEPROJECT_NAME}_Development"
  )

  install(
    FILES "${PACKAGEPROJECT_BINARY_DIR}/${PACKAGEPROJECT_NAME}ConfigVersion.cmake"
          "${PACKAGEPROJECT_BINARY_DIR}/${PACKAGEPROJECT_NAME}Config.cmake"
    DESTINATION "${${PACKAGEPROJECT_NAME}_INSTALL_CMAKEDIR}"
    COMPONENT "${PACKAGEPROJECT_NAME}_Development"
  )

  if(NOT DEFINED PACKAGEPROJECT_INCLUDE_HEADER_PATTERN)
    set(PACKAGEPROJECT_INCLUDE_HEADER_PATTERN "*")
  endif()

  if(PACKAGEPROJECT_INCLUDE_DESTINATION AND PACKAGEPROJECT_INCLUDE_DIR)
    install(
      DIRECTORY ${PACKAGEPROJECT_INCLUDE_DIR}/
      DESTINATION ${PACKAGEPROJECT_INCLUDE_DESTINATION}
      COMPONENT "${PACKAGEPROJECT_NAME}_Development"
      FILES_MATCHING
      PATTERN "${PACKAGEPROJECT_INCLUDE_HEADER_PATTERN}"
    )
  endif()

  set(${PACKAGEPROJECT_NAME}_VERSION
      ${PACKAGEPROJECT_VERSION}
      CACHE INTERNAL ""
  )

  if(PACKAGEPROJECT_CPACK)
    if(CPACK_PACKAGE_NAMESPACE)
      set(CPACK_PACKAGE_NAME ${CPACK_PACKAGE_NAMESPACE}-${PACKAGEPROJECT_NAME})
    else()
      set(CPACK_PACKAGE_NAME ${PACKAGEPROJECT_NAME})
    endif()
    if(NOT CPACK_PACKAGE_DESCRIPTION_SUMMARY)
      set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "${PACKAGEPROJECT_DESCRIPTION}")
    endif()
    if(NOT CPACK_PACKAGE_HOMEPAGE_URL)
      set(CPACK_PACKAGE_HOMEPAGE_URL "${PACKAGEPROJECT_HOMEPAGE_URL}")
    endif()
    set(CPACK_VERBATIM_VARIABLES YES)
    set(CPACK_THREADS 0)
    set(CPACK_PACKAGE_VERSION_MAJOR ${PACKAGEPROJECT_VERSION_MAJOR})
    set(CPACK_PACKAGE_VERSION_MINOR ${PACKAGEPROJECT_VERSION_MINOR})
    set(CPACK_PACKAGE_VERSION_PATCH ${PACKAGEPROJECT_VERSION_PATCH})

    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/README.md")
      set(CPACK_RESOURCE_FILE_README "${CMAKE_CURRENT_SOURCE_DIR}/README.md")
    endif()

    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    set(CPACK_INSTALL_DEFAULT_DIRECTORY_PERMISSIONS
        OWNER_READ
        OWNER_WRITE
        OWNER_EXECUTE
        GROUP_READ
        GROUP_EXECUTE
        WORLD_READ
        WORLD_EXECUTE
    )

    include(CPack)
  endif()
endfunction()
